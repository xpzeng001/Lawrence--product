{
  "voice": "Reed (中文（中国大陆）)",
  "rate": 215,
  "note": "S1 uses the opening video audio; narration starts from S2 and follows the current edited picture.",
  "segments": [
    {
      "id": "p01",
      "start": 15.35,
      "text": "开场先讲清楚，Lawrence 不是一个聊天框。",
      "duration": 3.642
    },
    {
      "id": "p02",
      "start": 19.849,
      "text": "它更像能上岗的专业数字员工。",
      "duration": 2.618
    },
    {
      "id": "p03",
      "start": 23.527,
      "text": "有岗位、有权限，也能接入企业流程。",
      "duration": 3.071
    },
    {
      "id": "p04",
      "start": 27.525,
      "text": "所以我们看的不是功能清单，而是工作方式。",
      "duration": 3.406
    },
    {
      "id": "p05",
      "start": 31.1,
      "text": "从身份、工位到技能，形成一套完整协作。",
      "duration": 3.578
    },
    {
      "id": "p06",
      "start": 36.65,
      "text": "第一步，是给数字员工配置企业身份。",
      "duration": 3.05
    },
    {
      "id": "p07",
      "start": 40.65,
      "text": "电脑、账号、邮箱和任务系统，组成它的工位。",
      "duration": 3.658
    },
    {
      "id": "p08",
      "start": 45.3,
      "text": "飞书、企微、钉钉、邮件和桌面端，都可以成为入口。",
      "duration": 4.095
    },
    {
      "id": "p09",
      "start": 50.45,
      "text": "入口不同，后面进入同一套任务流程。",
      "duration": 3.071
    },
    {
      "id": "p10",
      "start": 57.05,
      "text": "交代任务时，不是许愿，而是像对同事说明工作。",
      "duration": 3.802
    },
    {
      "id": "p11",
      "start": 62.15,
      "text": "语音说明目标，文件补充背景。",
      "duration": 2.718
    },
    {
      "id": "p12",
      "start": 65.55,
      "text": "文字再明确截止时间和交付标准。",
      "duration": 2.686
    },
    {
      "id": "p13",
      "start": 68.95,
      "text": "Lawrence 会先理解，再追问。",
      "duration": 2.475
    },
    {
      "id": "p14",
      "start": 72.102,
      "text": "任务就变成了可执行委托。",
      "duration": 2.223
    },
    {
      "id": "p15",
      "start": 74.425,
      "text": "接收之后，它把任务拆成后台流程。",
      "duration": 2.922
    },
    {
      "id": "p16",
      "start": 77.735,
      "text": "读取文件，抽取条款、事实和风险点。",
      "duration": 3.322
    },
    {
      "id": "p17",
      "start": 81.2,
      "text": "再匹配企业记忆、合规规则和审批要求。",
      "duration": 3.098
    },
    {
      "id": "p18",
      "start": 84.75,
      "text": "最后输出可回传、可审核，也可追溯。",
      "duration": 3.306
    },
    {
      "id": "p19",
      "start": 107.4,
      "text": "大模型只是大脑，不等于完整员工。",
      "duration": 2.81
    },
    {
      "id": "p20",
      "start": 111.1,
      "text": "真正支撑长期工作的，是数字工位。",
      "duration": 3.066
    },
    {
      "id": "p21",
      "start": 114.3,
      "text": "文件、任务、账号、工具、记忆和审计，都在这里连接。",
      "duration": 3.934
    },
    {
      "id": "p22",
      "start": 121.9,
      "text": "敏感资料先脱敏，再进入处理链路。",
      "duration": 2.974
    },
    {
      "id": "p23",
      "start": 125.487,
      "text": "所以它可以在企业内部稳定运行。",
      "duration": 2.51
    },
    {
      "id": "p24",
      "start": 128.402,
      "text": "第一类能力，是法律合规。",
      "duration": 2.106
    },
    {
      "id": "p25",
      "start": 131.1,
      "text": "合同审查，定位付款、终止和责任风险。",
      "duration": 3.391
    },
    {
      "id": "p26",
      "start": 141.455,
      "text": "法律研究，保留法规、案例和引用关系。",
      "duration": 3.151
    },
    {
      "id": "p27",
      "start": 144.9,
      "text": "尽调和合规监控，把风险图谱和处置任务串起来。",
      "duration": 4.122
    },
    {
      "id": "p28",
      "start": 151.05,
      "text": "战略管理，是把判断变成执行。",
      "duration": 2.762
    },
    {
      "id": "p29",
      "start": 153.928,
      "text": "快研整理客户、市场和竞品。",
      "duration": 2.458
    },
    {
      "id": "p30",
      "start": 156.75,
      "text": "目标拆成负责人、节点和验收标准。",
      "duration": 2.846
    },
    {
      "id": "p31",
      "start": 159.7,
      "text": "再跟进阻塞与复盘。",
      "duration": 1.706
    },
    {
      "id": "p32",
      "start": 162.15,
      "text": "增长，从全网情报开始。",
      "duration": 2.49
    },
    {
      "id": "p33",
      "start": 164.937,
      "text": "持续监控内容、账号和话题。",
      "duration": 2.362
    },
    {
      "id": "p34",
      "start": 168.2,
      "text": "整理成选题、脚本和渠道建议。",
      "duration": 2.586
    },
    {
      "id": "p35",
      "start": 171.45,
      "text": "内容生产时，保留品牌口径。",
      "duration": 2.574
    },
    {
      "id": "p36",
      "start": 174.4,
      "text": "一份素材，适配多个渠道。",
      "duration": 2.255
    },
    {
      "id": "p37",
      "start": 177.411,
      "text": "发布之后，再进入营销复盘。",
      "duration": 2.447
    },
    {
      "id": "p38",
      "start": 180.598,
      "text": "看内容表现、渠道效果和线索质量。",
      "duration": 2.794
    },
    {
      "id": "p39",
      "start": 184.45,
      "text": "下一轮主题、话术和承接动作，也一起给出。",
      "duration": 3.535
    },
    {
      "id": "p40",
      "start": 188.65,
      "text": "这让营销从一次发布，变成持续迭代。",
      "duration": 3.146
    },
    {
      "id": "p41",
      "start": 194.85,
      "text": "专业能力沉淀之后，会进入 WiseSkill Hub。",
      "duration": 3.37
    },
    {
      "id": "p42",
      "start": 198.85,
      "text": "每个 Skill 都可以审核、验证，并持续升级。",
      "duration": 3.47
    },
    {
      "id": "p43",
      "start": 202.95,
      "text": "客户也可以在安全工作区中使用这些能力。",
      "duration": 3.274
    },
    {
      "id": "p44",
      "start": 207.2,
      "text": "权限、日志、审计和数据边界，都保持可控。",
      "duration": 3.69
    },
    {
      "id": "p45",
      "start": 213.25,
      "text": "最后，是课程培训和场景陪跑。",
      "duration": 2.826
    },
    {
      "id": "p46",
      "start": 216.95,
      "text": "团队不是只学工具，而是把 Lawrence 放进真实业务。",
      "duration": 3.866
    },
    {
      "id": "p47",
      "start": 221.55,
      "text": "陪跑中沉淀模板、检查项和专属 Skill。",
      "duration": 3.322
    },
    {
      "id": "p48",
      "start": 225.75,
      "text": "当能力进入日常流程，数字员工才真正成为团队的一部分。",
      "duration": 4.586
    }
  ]
}
